# Postgres (docker-compose ile local'de calisir; emirhanoto projesiyle port catismasin diye 5433 kullanilir)
DATABASE_URL=postgresql://psikosanal:psikosanal_dev_password@localhost:5433/psikosanal

# Oturum (session) imzalama anahtari - "openssl rand -base64 32" ile uretilebilir
SESSION_SECRET=change-this-to-a-random-32-byte-base64-string

# S3 uyumlu depolama (local'de MinIO, production'da AWS S3 / Cloudflare R2 olabilir)
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=psikosanal
S3_SECRET_ACCESS_KEY=psikosanal_dev_password
S3_BUCKET=psikosanal
# MinIO'da path-style erisim gerekir; gercek AWS S3'te "false" yapin
S3_FORCE_PATH_STYLE=true
# Tarayicidan gorsellere erisim icin public base URL (local'de MinIO console/proxy)
S3_PUBLIC_URL=http://localhost:9002/psikosanal

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Video görüşme (WebRTC) imzalama — apps/api/.env'deki API_JWT_SECRET ile
# BİREBİR AYNI olmalı. apps/web bu anahtarla kısa ömürlü bir "görüşme odasına
# katılma izni" token'ı imzalar, apps/api'deki WebSocket sinyalleşme sunucusu
# bu token'ı doğrular (iki uygulama bağımsız oturum sistemlerine sahip
# olduğu için bu token ikisi arasındaki köprüdür).
API_JWT_SECRET=change-this-to-a-random-32-byte-base64-string
# apps/api'nin tarayıcıdan erişilebilir adresi (WebSocket sinyalleşme için)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Ilk admin kullanicisi (scripts/seed.ts tarafindan kullanilir)
SEED_ADMIN_EMAIL=admin@psikosanal.com
SEED_ADMIN_PASSWORD=change-this-password

# Fastify API (apps/api) - bu dosyadan ayri kendi env dosyasini kullanir,
# bkz. apps/api/.env.example (API_JWT_SECRET, CORS_ORIGINS, RATE_LIMIT_* vb.)
