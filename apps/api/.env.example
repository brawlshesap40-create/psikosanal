# Postgres — same database as the web app (see root .env.example)
DATABASE_URL=postgresql://psikosanal:psikosanal_dev_password@localhost:5433/psikosanal

# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# JWT access/refresh auth — MUST be a different secret from the web app's
# SESSION_SECRET (they are two independent, non-interchangeable auth
# transports). Generate with: openssl rand -base64 32
API_JWT_SECRET=change-this-to-a-random-32-byte-base64-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Which web/mobile origins may call this API from a browser
CORS_ORIGINS=http://localhost:3000

# Rate limiting on auth endpoints (login, register, refresh, ...)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=1 minute
