{
  "name": "@psikosanal/mobile",
  "private": true,
  "version": "0.1.0",
  "description": "Psikosanal Android uygulaması (Capacitor kabuğu)",
  "scripts": {
    "sync": "cap sync",
    "add:android": "cap add android",
    "open:android": "cap open android",
    "copy": "cap copy",
    "assets": "capacitor-assets generate --android",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "apk:release": "cd android && ./gradlew assembleRelease",
    "bundle:release": "cd android && ./gradlew bundleRelease",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/network": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.0",
    "typescript": "^5"
  }
}
